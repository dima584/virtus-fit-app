# Copy this file to .env locally. Never commit real credentials.
BOT_TOKEN=
ADMIN_ID=
CRYPTO_PAY_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=

# Cloudflare Dashboard: Account ID and Workers AI API token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_GEMMA_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper
CLOUDFLARE_AI_TIMEOUT=90
CLOUDFLARE_AI_MAX_CONCURRENCY=6
